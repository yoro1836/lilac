From: wayondroid
Origin: own

In AHB mode the external memory handle is an AHardwareBuffer*, not an
fd: import it as one. VK_ANDROID_native_buffer images and imported
ColorBuffers failed with VK_ERROR_UNKNOWN on the Xclipse driver.

diff --git a/host/vulkan/vk_common_operations.cpp b/host/vulkan/vk_common_operations.cpp
index 8f67b2f3f..4ae8d836a 100644
--- a/host/vulkan/vk_common_operations.cpp
+++ b/host/vulkan/vk_common_operations.cpp
@@ -2493,6 +2493,22 @@ bool VkEmulation::importExternalMemory(VulkanDispatch* vk, VkDevice targetDevice
 #endif
 
     const void* importInfoPtr = nullptr;
+#if defined(__ANDROID__)
+    // AHB mode keeps an AHardwareBuffer*, not an fd
+    VkImportAndroidHardwareBufferInfoANDROID importInfoAhb;
+    if (mDeviceInfo.externalMemoryMode == ExternalMemory::Mode::AndroidAHB) {
+        if (!handleInfo || !handleInfo->handle) {
+            GFXSTREAM_ERROR("importExternalMemory: no AHardwareBuffer to import");
+            return false;
+        }
+        importInfoAhb = {
+            VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+            dedicatedAllocInfoPtr,
+            reinterpret_cast<AHardwareBuffer*>(static_cast<intptr_t>(handleInfo->handle)),
+        };
+        importInfoPtr = &importInfoAhb;
+    } else
+#endif
     switch (mDeviceInfo.externalMemoryMode) {
         case ExternalMemory::Mode::AndroidAHB:
         case ExternalMemory::Mode::OpaqueFd: {
