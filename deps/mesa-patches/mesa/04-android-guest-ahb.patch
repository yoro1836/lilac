@@ -2183,6 +2183,23 @@ void ResourceTracker::on_vkGetPhysicalDeviceProperties2(void* context,
     if (!pProperties) {
         return;
     }
+    // Android's loader asks for VkPhysicalDevicePresentationPropertiesANDROID,
+    // which the host does not decode: answer it here, without the host
+    VkBaseOutStructure* presentation = nullptr;
+    for (VkBaseOutStructure* p = (VkBaseOutStructure*)pProperties; p->pNext; p = p->pNext) {
+        if (p->pNext->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENTATION_PROPERTIES_ANDROID) {
+            presentation = p->pNext;
+            p->pNext = presentation->pNext;
+            presentation->pNext = (VkBaseOutStructure*)pProperties->pNext;
+            break;
+        }
+    }
+    VkEncoder* enc = (VkEncoder*)context;
+    enc->vkGetPhysicalDeviceProperties2(physicalDevice, pProperties, true /* do lock */);
+    if (presentation) {
+        ((VkPhysicalDevicePresentationPropertiesANDROID*)presentation)->sharedImage = VK_FALSE;
+        pProperties->pNext = presentation;
+    }
 #ifdef LINUX_GUEST_BUILD
     if (VK_PHYSICAL_DEVICE_TYPE_CPU == pProperties->properties.deviceType) {
         /* For Linux guest: Even if host driver reports DEVICE_TYPE_CPU,
