diff --git a/src/gfxstream/guest/android/GfxStreamGralloc.cpp b/src/gfxstream/guest/android/GfxStreamGralloc.cpp
index 1a70a9d..515c730 100644
--- a/src/gfxstream/guest/android/GfxStreamGralloc.cpp
+++ b/src/gfxstream/guest/android/GfxStreamGralloc.cpp
@@ -11,17 +11,25 @@
 #include <string>
 
 #include "GrallocGoldfish.h"
+#if __has_include(<cros_gralloc/cros_gralloc_handle.h>)
+#define GFXSTREAM_HAS_MINIGBM 1
 #include "GrallocMinigbm.h"
+#endif
 #include "android-base/properties.h"
 
 namespace gfxstream {
 
 Gralloc* createPlatformGralloc(int32_t descriptor) {
     const std::string value = android::base::GetProperty("ro.hardware.gralloc", "");
+#ifdef GFXSTREAM_HAS_MINIGBM
     if (value == "minigbm") {
         auto gralloc = new MinigbmGralloc(descriptor);
         return gralloc;
     }
+#else
+    (void)value;
+    (void)descriptor;
+#endif
     return new GoldfishGralloc();
 }
 
