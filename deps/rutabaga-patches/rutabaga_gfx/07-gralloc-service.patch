+// wayondroid: buffers for the guest's gralloc. A gralloc buffer is a 3D
+// resource (a gfxstream ColorBuffer, its handle the resource id) with a
+// guest-shared backing for CPU access, attached to no context: it lives
+// until every guest copy of its lifetime socket is closed.
+impl KumquatGpu {
+    pub fn gralloc_alloc(
+        &mut self,
+        create: ResourceCreate3D,
+        size: usize,
+    ) -> KumquatGpuResult<(u32, OwnedDescriptor)> {
+        let descriptor: OwnedDescriptor = SharedMemory::new("gralloc", size as u64)?.into();
+        let clone = descriptor.try_clone().map_err(MesaError::IoError)?;
+        let mapping = MemoryMapping::from_safe_descriptor(
+            clone,
+            size,
+            RUTABAGA_MAP_CACHE_CACHED | RUTABAGA_MAP_ACCESS_RW,
+        )?;
+        let vecs = vec![RutabagaIovec {
+            base: mapping.as_mesa_mapping().ptr as *mut c_void,
+            len: size,
+        }];
+        let resource_id = self.allocate_id();
+        self.rutabaga.resource_create_3d(resource_id, create)?;
+        self.rutabaga.attach_backing(resource_id, vecs)?;
+        self.resources.insert(
+            resource_id,
+            KumquatGpuResource {
+                attached_contexts: Default::default(),
+                mapping: Some(mapping),
+            },
+        );
+        Ok((resource_id, descriptor))
+    }
+
+    pub fn gralloc_free(&mut self, resource_id: u32) {
+        if let Some(resource) = self.resources.remove(&resource_id) {
+            if resource.mapping.is_some() {
+                let _ = self.rutabaga.detach_backing(resource_id);
+            }
+            let _ = self.rutabaga.unref_resource(resource_id);
+        }
+    }
+
+    pub fn gralloc_transfer(
+        &mut self,
+        resource_id: u32,
+        to_host: bool,
+        transfer: Transfer3D,
+    ) -> KumquatGpuResult<()> {
+        if to_host {
+            self.rutabaga.transfer_write(0, resource_id, transfer, None)?;
+        } else {
+            self.rutabaga.transfer_read(0, resource_id, transfer, None)?;
+        }
+        Ok(())
+    }
+}
