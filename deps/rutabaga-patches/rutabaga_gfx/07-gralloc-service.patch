+    /// One gralloc request, 12 little-endian words: an op and its args.
+    /// ALLOC (target, format, bind, width, height, size) answers
+    /// (status, resource id) with the CPU backing and a lifetime socket;
+    /// TRANSFER (resource id, to host, x, y, w, h, stride) answers
+    /// (status, 0) once the copy is done. Returns false on hang up.
+    fn gralloc_request(&mut self, tube: &Tube) -> KumquatGpuResult<bool> {
+        let mut buf = [0u8; 48];
+        let (n, _) = tube.receive(&mut buf)?;
+        if n == 0 {
+            return Ok(false);
+        }
+        if n < 48 {
+            return Err(MesaError::WithContext("short gralloc request").into());
+        }
+        self.ensure_gpu()?;
+        let gpu = self.kumquat_gpu_opt.as_mut().unwrap();
+        let mut reply = [0u8; 8];
+        let mut status: i32 = 0;
+        match word(&buf, 0) {
+            GRALLOC_ALLOC => {
+                let create = ResourceCreate3D {
+                    target: word(&buf, 1),
+                    format: word(&buf, 2),
+                    bind: word(&buf, 3),
+                    width: word(&buf, 4),
+                    height: word(&buf, 5),
+                    depth: 1,
+                    array_size: 1,
+                    last_level: 0,
+                    nr_samples: 0,
+                    flags: 0,
+                };
+                match gpu.gralloc_alloc(create, word(&buf, 6) as usize) {
+                    Ok((resource_id, shm)) => {
+                        let (ours, theirs) = UnixStream::pair().map_err(MesaError::IoError)?;
+                        let ours = owned(ours);
+                        self.connection_id += 1;
+                        self.wait_ctx.add(self.connection_id, &ours)?;
+                        self.connections.insert(
+                            self.connection_id,
+                            KumquatConnection::GrallocLifetime(resource_id, ours),
+                        );
+                        reply[4..].copy_from_slice(&resource_id.to_le_bytes());
+                        tube.send(&reply, &[shm, owned(theirs)])?;
+                        return Ok(true);
+                    }
+                    Err(e) => {
+                        eprintln!("kumquat: gralloc alloc failed: {:?}", e);
+                        status = -12;
+                    }
+                }
+            }
+            GRALLOC_TRANSFER => {
+                let transfer = Transfer3D {
+                    x: word(&buf, 3),
+                    y: word(&buf, 4),
+                    z: 0,
+                    w: word(&buf, 5),
+                    h: word(&buf, 6),
+                    d: 1,
+                    level: 0,
+                    stride: word(&buf, 7),
+                    layer_stride: 0,
+                    offset: 0,
+                };
+                if let Err(e) = gpu.gralloc_transfer(word(&buf, 1), word(&buf, 2) != 0, transfer) {
+                    eprintln!("kumquat: gralloc transfer failed: {:?}", e);
+                    status = -5;
+                }
+            }
+            _ => status = -22,
+        }
+        reply[..4].copy_from_slice(&status.to_le_bytes());
+        tube.send(&reply, &[])?;
+        Ok(true)
+    }
