{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Gradle dependencies resolve from Google Maven, Maven Central, and the Gradle plugin portal",
      "matchManagers": ["gradle"],
      "registryUrls": [
        "https://maven.google.com/",
        "https://repo.maven.apache.org/maven2/",
        "https://plugins.gradle.org/m2/"
      ]
    },
    {
      "description": "Compose and Activity move together",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["androidx.compose*", "androidx.activity*"],
      "groupName": "compose"
    },
    {
      "description": "All other AndroidX libraries",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["androidx.*", "!androidx.compose*", "!androidx.activity*"],
      "groupName": "androidx"
    },
    {
      "description": "Kotlin and KSP versions are tied together",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.jetbrains.kotlin*", "com.google.devtools.ksp*"],
      "groupName": "kotlin"
    }
  ]
}
